# Désactiver le listage des répertoires
Options -Indexes

# Protection des fichiers sensibles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|sql|md|json)$">
    Require all denied
</FilesMatch>

# Bloquer l'accès au dossier /api/migration/
RewriteEngine On

RewriteRule ^api/migration(?:/|$) - [F,L]