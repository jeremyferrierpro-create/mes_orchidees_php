# 1. Désactiver le listage des répertoires
Options -Indexes

# 2. Protection des fichiers cachés (.git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Protection des fichiers sensibles par extension
<FilesMatch "\.(env|sql|md|json)$">
    Require all denied
</FilesMatch>

# 4. Protection du dossier des migrations SQL (remplace la directive <Directory>)
RewriteEngine On
RewriteRule ^api/migration/ - [F,L]