# 1. Désactiver le listage des répertoires
Options -Indexes

# 2. Protection des fichiers cachés (.git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Protection des fichiers système sensibles uniquement (env, sql, markdown, logs)
<FilesMatch "\.(env|sql|md|log|ini)$">
    Require all denied
</FilesMatch>

# 4. Protection du dossier des migrations SQL
RewriteEngine On
RewriteRule ^api/migration/ - [F,L]