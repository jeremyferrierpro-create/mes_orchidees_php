# Exemple de fichier d'environnement
# NE PAS COMMITTER le vrai fichier .env avec vos secrets.

# ==========================================
# BASE DE DONNEES (Neon PostgreSQL)
# ==========================================
# Remplacez par le "Connection string" fourni par Neon (onglet Dashboard).
NEON_DSN=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ==========================================
# SECURITE (Authentification JWT)
# ==========================================
# Chaine aleatoire de 64 caracteres.
# Vous pouvez la generer en PHP avec : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=GENERER_UNE_CHAINE_ALEATOIRE_LONGUE_ICI

# ==========================================
# ENVIRONNEMENT
# ==========================================
APP_ENV=development
APP_DEBUG=true

# Configuration des cookies de session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Strict
